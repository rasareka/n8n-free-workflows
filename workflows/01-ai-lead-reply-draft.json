    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Safe defaults: if the AI fails, the lead is still logged for you to answer by hand.\nconst aiJson = (j) => { try { const o = (j.output || []).find((x) => x.type === 'message'); const t = o && (o.content || []).find((x) => x.type === 'output_text'); const v = t ? t.text : (j.text ?? null); return typeof v === 'string' ? JSON.parse(v) : v; } catch (e) { return null; } };\nconst a = aiJson($input.first().json) || {};\nconst failed = !a.summary;\nreturn [{ json: { score: Math.max(0, Math.min(100, Number(a.score) || 0)), summary: failed ? 'AI unavailable: reply manually' : a.summary, spam: !!a.spam,\n  subject: a.subject || 'Thanks for getting in touch', reply: failed || a.spam ? '' : String(a.reply || '').trim(), status: failed ? 'needs_review' : a.spam ? 'spam' : 'draft_ready' } }];"
      },
